UPLOAD_DIR=storage/uploads
JOBS_DIR=storage/jobs
MODELS_DIR=storage/models
MAX_FILE_SIZE_GB=5

CHUNK_DURATION_SECONDS=60
CHUNK_OVERLAP_SECONDS=5
AUDIO_SAMPLE_RATE=16000

PARAKEET_MODEL_ID=nvidia/parakeet-tdt-1.1b
QWEN_LID_MODEL_ID=Qwen/Qwen3-ASR-0.6B
QWEN_ASR_MODEL_ID=Qwen/Qwen3-ASR-1.7B
WHISPER_MODEL_SIZE=large-v3-turbo
FORCED_ALIGNER_MODEL_ID=Qwen/Qwen3-ForcedAligner-0.6B
DEMUCS_MODEL_NAME=htdemucs

LID_CONFIDENCE_THRESHOLD=0.70
CODE_SWITCH_THRESHOLD=0.85

DATABASE_URL=sqlite+aiosqlite:///./shravana.db

PIPELINE_CONCURRENCY=1
SHRAVANA_SERVE_UI=false

# Server port — read by both uvicorn launcher (backend/run.py) and Vite proxy
BACKEND_PORT=8000

# --- Translation / VLM ---
# 3B is the default (~2-2.5 GB VRAM with 4-bit quant, ~6 GB fp16).
# Switch to 7B for higher quality at the cost of ~4 GB VRAM (4-bit).
# QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_VL_MODEL_ID=Qwen/Qwen2.5-VL-3B-Instruct

# 4-bit NF4 quantization via bitsandbytes (CUDA only; silently skipped on CPU).
# Install bitsandbytes first: pip install "shravana[gpu]" or pip install bitsandbytes>=0.43.0
# VLM_USE_4BIT=true

# Max visual token budget per image (256 × 28 × 28 patches ≈ 448×448).
# Raise to 1003520 (1280 patches) for highest fidelity at the cost of speed.
# VLM_MAX_PIXELS=200704